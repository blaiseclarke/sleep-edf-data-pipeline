# Copy to .env and edit. Docker Compose and the Python entry points read this
# file automatically; dbt does not, so export it first:
#   export $(grep -v '^#' .env | xargs)

# --- Warehouse: duckdb (default) or snowflake ---
WAREHOUSE_TYPE=duckdb
DB_PATH=data/sleep_data.db

# --- Ingestion range ---
# Age study subjects run 0-82, telemetry 0-21.
STARTING_SUBJECT=0
ENDING_SUBJECT=10
RECORDING=1
STUDY=age
STAGING_DIR=data/staging

# How many subjects are extracted at once. Each worker holds a batch of epochs
# in memory, so lower this if the machine is memory constrained.
PREFECT_MAX_WORKERS=3

# --- Snowflake (only when WAREHOUSE_TYPE=snowflake) ---
# The role needs CREATE TABLE on the target schema; the pipeline creates
# SLEEP_EPOCHS and INGESTION_ERRORS itself on first run.
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_ROLE=your_role
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=EEG_ANALYTICS
# SNOWFLAKE_SCHEMA=RAW

# --- dbt source location ---
# DuckDB derives these from DB_PATH. For Snowflake, point them at the database
# and schema the loader writes to, or the models will read from the wrong place.
# DBT_SOURCE_DATABASE=EEG_ANALYTICS
# DBT_SOURCE_SCHEMA=RAW
